<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.TaylanTatli.iCloud-Linux</id>

  <name>iCloud Linux</name>
  <summary>Access Apple iCloud services on Linux</summary>
  <icon type="stock">io.github.TaylanTatli.iCloud-Linux</icon>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <description>
    <p>
      iCloud Linux provides native desktop access to Apple iCloud services.
      Each service opens in its own window using the system WebKit engine,
      giving you a clean, integrated experience on the Linux desktop.
    </p>
    <p>Available services:</p>
    <ul>
      <li>Mail</li>
      <li>Contacts</li>
      <li>Calendar</li>
      <li>Photos</li>
      <li>iCloud Drive</li>
      <li>Notes</li>
      <li>Reminders</li>
      <li>Pages</li>
      <li>Numbers</li>
      <li>Keynote</li>
      <li>Find My</li>
    </ul>
    <p>
      The TLD (top-level domain) can be customised by placing your preferred
      domain suffix (e.g. <code>.com.cn</code>) in the file
      <code>~/.local/share/icloud-linux/tld</code>.
    </p>
  </description>

